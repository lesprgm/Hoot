# Providers
GAZE_PROVIDER=webeyetrack            # webeyetrack | realeye | simulated
TTS_PROVIDER=elevenlabs              # elevenlabs | macos | mute
EXECUTOR_PROVIDER=openai             # openai only
DECODER_PROVIDER=openai              # openai | gemini | fixture

# OpenAI
OPENAI_API_KEY=
EXECUTOR_MODEL=gpt-6-astra

# Decoder model (provider selected above)
DECODER_MODEL=gpt-5.6-luna       # use gemini-3.5-flash-lite with DECODER_PROVIDER=gemini

# Gemini AI Studio (optional decoder alternative)
GEMINI_API_KEY=
# With DECODER_PROVIDER=gemini, set DECODER_MODEL=gemini-3.5-flash.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Interaction
GAZE_DWELL_MS=550
AGENT_SUMMON_DWELL_MS=900
NONE_DWELL_MS=700
CANCEL_DWELL_MS=900
HINT_DWELL_MS=650
GAZE_EMA_ALPHA=0.28

# Safety/demo
EXECUTION_MODE=live                 # live only; desktop actions are never simulated
SIMULATE_GAZE=false
DEBUG_HUD=false
AUTO_SCROLL_ENABLED=true
PREFETCH_ENABLED=true
TTS_PREFETCH_ENABLED=true
