# Providers
GAZE_PROVIDER=webeyetrack            # webeyetrack | realeye | simulated
TTS_PROVIDER=elevenlabs              # elevenlabs | macos | mute
EXECUTOR_PROVIDER=openai             # openai only
DECODER_PROVIDER=openrouter           # openai | gemini | openrouter | fixture

# OpenAI
OPENAI_API_KEY=
EXECUTOR_MODEL=gpt-6-astra

# Decoder model (provider selected above)
DECODER_MODEL=deepseek/deepseek-v4-flash-0731

# OpenRouter (recommended low-latency decoder)
OPENROUTER_API_KEY=

# Gemini AI Studio (optional decoder alternative)
GEMINI_API_KEY=
# Used automatically when the OpenAI/OpenRouter decoder fails.
GEMINI_DECODER_MODEL=gemini-3.5-flash
# With DECODER_PROVIDER=gemini, set DECODER_MODEL=gemini-3.5-flash.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.46
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.05
ELEVENLABS_USE_SPEAKER_BOOST=false
ELEVENLABS_SPEED=1.0

# Interaction
GAZE_DWELL_MS=1500
AGENT_SUMMON_DWELL_MS=900
NONE_DWELL_MS=700
CANCEL_DWELL_MS=900
HINT_DWELL_MS=650
GAZE_EMA_ALPHA=0.28

# Safety/demo
EXECUTION_MODE=live                 # live only; desktop actions are never simulated
SIMULATE_GAZE=false
DEBUG_HUD=false
AUTO_SCROLL_ENABLED=true
PREFETCH_ENABLED=true
TTS_PREFETCH_ENABLED=true
