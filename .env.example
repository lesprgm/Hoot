# Providers
GAZE_PROVIDER=webeyetrack            # webeyetrack | simulated
TTS_PROVIDER=elevenlabs              # elevenlabs | macos | mute
EXECUTOR_PROVIDER=openai             # openai only
DECODER_PROVIDER=openrouter           # openrouter | gemini | fixture
DECODER_FALLBACK_PROVIDER=none        # none | gemini (direct Gemini API); transport failures only
DECODER_VISION_PROVIDER=none          # none | gemini (direct Gemini API for approved window images)

# OpenAI
OPENAI_API_KEY=
EXECUTOR_MODEL=gpt-6-astra

# Decoder model (provider selected above)
DECODER_MODEL=deepseek/deepseek-v4-flash-0731

# OpenRouter (recommended low-latency decoder)
OPENROUTER_API_KEY=

# Gemini AI Studio API (optional direct decoder fallback or primary)
GEMINI_API_KEY=
# Used by the direct Gemini API when DECODER_PROVIDER=gemini,
# DECODER_FALLBACK_PROVIDER=gemini, or DECODER_VISION_PROVIDER=gemini.
GEMINI_DECODER_MODEL=gemini-3.5-flash-lite

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.46
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.05
ELEVENLABS_USE_SPEAKER_BOOST=false
ELEVENLABS_SPEED=1.0

# Interaction
GAZE_DWELL_MS=1500
AGENT_SUMMON_DWELL_MS=900
NONE_DWELL_MS=700
CANCEL_DWELL_MS=900
GAZE_EMA_ALPHA=0.28

# Context scope
# Empty means the app frontmost when the owl is summoned is approved for the
# session. Add comma-separated app names or bundle IDs to permit those apps as
# the user moves between them. Use * only when broad app access is intentional.
CONTEXT_ALLOWED_APPS=

# Optional bounded personalization. Values are comma-separated and are used
# only to rank or complete the current prompt; Hoot does not read a history log.
HOOTS_PEOPLE=
HOOTS_PLACES=
HOOTS_APPS=
HOOTS_RECURRING_PHRASES=
HOOTS_VOCABULARY=

# Safety/demo
EXECUTION_MODE=live                 # live only; desktop actions are never simulated
SIMULATE_GAZE=false
DEBUG_HUD=false
PREFETCH_ENABLED=true
DECODER_INTERACTION_DEADLINE_MS=15000
DECODER_REQUEST_MAX_MS=15000
CONTEXT_IN_SIMULATION=true       # capture approved active-window context during simulated gaze demos
TASK_AWARE_CARDS=false
HOOTS_RECORDING_MODE=false          # show Hoots overlay in recordings; Astra uses filtered ScreenCaptureKit
