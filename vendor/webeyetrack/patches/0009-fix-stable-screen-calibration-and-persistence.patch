index 0000000..5010172
--- /dev/null
+++ b/src/ScreenCalibration.ts
@@ -0,0 +1,59 @@
+import { Matrix, SingularValueDecomposition } from 'ml-matrix';
+
+export interface CalibrationPoint {
+  samples: number[][];
+  target: number[];
+}
+
+export interface ScreenCalibration {
+  version: 3;
+  matrix: number[][];
+  fitRmse: number;
+}
+
+function median(values: number[]): number {
+  const sorted = values.slice().sort((a, b) => a - b);
+  const middle = Math.floor(sorted.length / 2);
+  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
+}
+
+export function mapScreenPoint(calibration: ScreenCalibration, point: number[]): number[] {
+  return calibration.matrix.map(row => row[0] * point[0] + row[1] * point[1] + row[2]);
+}
+
+/** Fit one equal-weight observation per target to the unchanged network output.
+ * Normalising the predictors avoids poorly scaled camera output destabilising
+ * the least-squares solve. No held-out validation data enters this function. */
+export function fitScreenCalibration(points: CalibrationPoint[]): ScreenCalibration {
+  if (points.length !== 5) throw new Error('Screen calibration requires five collected targets.');
+  const finitePoint = (point: number[]) => point.length === 2 && point.every(Number.isFinite);
+  if (points.some(point => !finitePoint(point.target) || point.samples.length !== 3 || !point.samples.every(finitePoint))) {
+    throw new Error('Each calibration target requires three finite camera predictions.');
+  }
+  const source = points.map(point => [0, 1].map(axis => median(point.samples.map(sample => sample[axis]))));
+  const mean = [0, 1].map(axis => source.reduce((sum, point) => sum + point[axis], 0) / source.length);
+  const scale = [0, 1].map(axis => Math.sqrt(source.reduce((sum, point) => sum + (point[axis] - mean[axis]) ** 2, 0) / source.length));
+  if (scale.some(value => value < 1e-6)) throw new Error('Camera predictions do not vary across calibration targets.');
+  const design = new Matrix(source.map(point => [(point[0] - mean[0]) / scale[0], (point[1] - mean[1]) / scale[1], 1]));
+  const svd = new SingularValueDecomposition(design, { autoTranspose: true });
+  if (svd.rank < 3 || svd.condition > 1e4) throw new Error('Camera predictions cannot distinguish horizontal and vertical targets.');
+  const coefficients = svd.solve(new Matrix(points.map(point => point.target))).transpose().to2DArray();
+  const matrix = coefficients.map(row => [row[0] / scale[0], row[1] / scale[1], row[2] - row[0] * mean[0] / scale[0] - row[1] * mean[1] / scale[1]]);
+  const calibration: ScreenCalibration = { version: 3, matrix, fitRmse: 0 };
+  calibration.fitRmse = Math.sqrt(source.reduce((sum, point, index) => {
+    const mapped = mapScreenPoint(calibration, point);
+    return sum + (mapped[0] - points[index].target[0]) ** 2 + (mapped[1] - points[index].target[1]) ** 2;
+  }, 0) / source.length);
+  return readScreenCalibration(calibration);
+}
+
+/** Refuse incomplete/legacy saved state instead of accepting a base model. */
+export function readScreenCalibration(value: unknown): ScreenCalibration {
+  const saved = value as ScreenCalibration | null;
+  if (!saved || saved.version !== 3 || !Array.isArray(saved.matrix) || saved.matrix.length !== 2
+    || saved.matrix.some(row => !Array.isArray(row) || row.length !== 3 || !row.every(Number.isFinite))
+    || !Number.isFinite(saved.fitRmse) || saved.fitRmse < 0) {
+    throw new Error('Saved calibration is incomplete or incompatible. Recalibrate explicitly.');
+  }
+  return { version: 3, matrix: saved.matrix.map(row => row.slice()), fitRmse: saved.fitRmse };
+}
