<!-- red purple  60+19   -->
<colour r="255" g="119" b="209"/>
<!-- that is the first 60 letters --> 
<!-- now 20 colours for hiragana rainbow.
  10 and 10, almost identical, just intensity difference
  between the two groups
  -->
