<colour r="70" g="50" b="150"  />
<colour r="50" g="38" b="170"  />
<colour r="70" g="55" b="150"  />
<colour r="00" g="55" b="100"  />
<colour r="50" g="38" b="160"  />
<colour r="70" g="50" b="150"  />
<!-- next 10 letters unallocated -->
<colour r="0" g="255" b="255"/>
<colour r="180" g="238" b="180"/>
<colour r="155" g="205" b="155"/>
<colour r="0" g="255" b="255"/>
