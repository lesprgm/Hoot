<!-- 20 shades of pink and grey useful for punctuation -->
<!-- pink recommend using all five periodically -->
<!-- pinks 90 91 92 93 94 --> 
<!-- pink  used by old Hiragana  90  had g,b 192 -->
<colour r="255" g="172" b="172"/>
